# /etc/caddy/sites-available/pad on the VPS, linked from sites-enabled/,
# which the main Caddyfile imports. The global block below can't go in an
# imported file: on the VPS it's at the top of /etc/caddy/Caddyfile, and
# applies to every site there.
#
# No `log` directive on purpose: an access log would keep on disk who opened
# which root when, and every pad id they read or saved. What a request shows
# anyway: docs/guide/install.org, What the proxy sees.
{
  log {
    # Without an access log Caddy still logs a request it couldn't serve,
    # a 502 while pad restarts among them: the address, the path, the
    # headers (caddy run, v2.11.7).
    exclude http.log.error
  }
  servers {
    timeouts {
      # Default 1m: a client holding a connection open with half a header.
      read_header 10s
      # Default 1m idle, no rate: a body trickled a byte a minute. Now a
      # body must average 1 KiB/s; a full save (1 MiB) still gets 17 min.
      read_body_idle 10s 1024
    }
  }
}

pad.nassu.online {
  encode zstd gzip
  header {
    # No includeSubDomains: the other subdomains aren't this server.
    Strict-Transport-Security "max-age=63072000"
    X-Content-Type-Options nosniff
    # Links in a pad would otherwise tell the site they lead to the pad's path.
    Referrer-Policy no-referrer
    # A page this one opens can't reach back into it through window.opener.
    Cross-Origin-Opener-Policy same-origin
    Cross-Origin-Resource-Policy same-origin
    # The app sets these too (hooks.server.ts), but not on the files it
    # serves from static/ and the build. The Content-Security-Policy is the
    # app's alone (vite.config.ts): it needs a fresh nonce per page.
    -Server
  }
  reverse_proxy 127.0.0.1:5512
}
