# pad.nassu.online on the VPS, behind Caddy on the same host (deploy/Caddyfile).
# deploy.sh puts the build in /opt/pad/build; the database lives in
# /var/lib/pad, created and owned by the service.
[Unit]
Description=pad.nassu.online
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pad
Group=pad
StateDirectory=pad
StateDirectoryMode=0700
WorkingDirectory=/var/lib/pad
Environment=HOST=127.0.0.1
Environment=PORT=5512
Environment=PAD_DB=/var/lib/pad/pad.db
# Caddy appends the client's address last; without these every visitor shares
# Caddy's, for the rate limits and the wrong-password backoff.
Environment=ADDRESS_HEADER=x-forwarded-for
Environment=XFF_DEPTH=1
# adapter-bun's default is 512K, and a full pad is 512 KiB plus 28 bytes of
# encryption.
Environment=BODY_SIZE_LIMIT=1M
ExecStart=/usr/local/bin/bun /opt/pad/build/index.js
Restart=on-failure
RestartSec=3

# Sandbox: the whole system read-only except the state
# directory, no home directories, no way to gain privileges. Not
# MemoryDenyWriteExecute: untested with Bun's JIT.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
UMask=0077

[Install]
WantedBy=multi-user.target
