{
  "name": "pad.nassu.online",
  "private": true,
  "version": "0.2.1",
  "description": "A notepad at every URL, each root locked by its own password and encrypted in the browser",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NasreddinHodja/pad.nassu.online.git"
  },
  "homepage": "https://github.com/NasreddinHodja/pad.nassu.online",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "test": "bun test",
    "test:e2e": "playwright test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.19.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.1.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.3.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  }
}
